{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mistera-prd",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "assets": {
    "directory": "./.deploy/prd",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "MISTERA_DB",
      "database_name": "mistera-prd",
      "database_id": "ec5b19c8-4b50-4c5a-b9ed-e878d9338473"
    }
  ],
  "vars": {
    "MISTERA_AUTH_REQUIRED": "1"
  },
  "secrets": {
    "required": [
      "MISTERA_ACCESS_CODE",
      "MISTERA_SESSION_KEY",
      "MISTERA_PROGRESS_KEY"
    ]
  }
}
