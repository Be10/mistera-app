{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mistera-staging",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "assets": {
    "directory": "./.deploy/test",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "MISTERA_DB",
      "database_name": "mistera-test-progress",
      "database_id": "4dc0b767-144a-4499-ad12-a79ec3d7c468"
    }
  ]
}
